rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/houses/$(hid)).data.members;
    }

    // Each user only sees which house they belong to
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /houses/{hid} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.owner == request.auth.uid;
      // Joining with an invite link: add yourself, at most 2 people per house
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() <= 2
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members;

      match /members/{m} {
        allow read: if isMember(hid);
        allow write: if isMember(hid) && request.auth.uid == m;
      }
      match /house/{k} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
